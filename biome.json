        "src/lib/hil.js",
        "src/lib/optics.js",
        "src/lib/power.js",
        "src/lib/protocol.js",
        "src/lib/safety.js",
        "src/lib/sentryLoader.js",
        "src/lib/timing.js",
        "src/lib/torque.js",
        "src/lib/userValidation.js",
        "test/alts-search.test.js",
        "test/alts-ui.test.js",
        "test/alts.test.js",
